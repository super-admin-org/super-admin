<?php

namespace :namespace;

use Illuminate\Support\ServiceProvider;

class :class_nameServiceProvider extends ServiceProvider
{
    /**
     * {@inheritdoc}
     */
    public function boot(:class_name $extension)
    {
        if (! :class_name::boot()) {
            return ;
        }

        // Views in resources/views/<template>/ override resources/views/ for that template,
        // and a template can restyle this extension in <template>/extensions/:base_package/.
        if ($views = $extension->views()) {
            \SuperAdmin\Admin\Facades\Admin::template()->extensionViews(':base_package', $views);
        }

        if ($this->app->runningInConsole() && $assets = $extension->assets()) {
            $this->publishes(
                [$assets => public_path('vendor/:package')],
                ':base_package'
            );
        }

        $this->app->booted(function () {
            :class_name::routes(__DIR__.'/../routes/web.php');
        });
    }
}